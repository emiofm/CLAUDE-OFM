# ---------------------------------------------------------------------------
# Creator Finder — server-side configuration. NEVER commit a real .env file.
# Copy to .env and fill in. Secrets are only read by the backend.
# ---------------------------------------------------------------------------

# Meta / Threads app (developers.facebook.com -> your app -> Use cases -> Threads API -> Settings)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Optional: a long-lived user token generated manually. Prefer the OAuth flow
# (Settings -> Connect Threads); a token stored via OAuth takes precedence.
THREADS_ACCESS_TOKEN=

# Must exactly match a "Redirect Callback URL" configured in the Meta app.
# Meta requires HTTPS for redirect URIs; for local dev use a tunnel (see README).
THREADS_REDIRECT_URI=http://localhost:8000/auth/threads/callback
THREADS_SCOPES=threads_basic,threads_keyword_search,threads_profile_discovery

# Local request budgets per rolling 24h (stay under Meta's limits)
THREADS_KEYWORD_SEARCH_DAILY_BUDGET=500
THREADS_PROFILE_DAILY_BUDGET=800

# Database: SQLite for development, PostgreSQL for production
# DATABASE_URL=postgresql+psycopg2://creator:creator@localhost:5432/creator_finder
DATABASE_URL=

# Optional Fernet key to encrypt OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Image embeddings: any Hugging Face CLIP/SigLIP checkpoint (needs requirements-ml.txt),
# e.g. openai/clip-vit-base-patch32, openai/clip-vit-large-patch14, google/siglip-base-patch16-224
# "debug-color-histogram" = dependency-free fallback for development only (not semantic).
EMBEDDING_MODEL=openai/clip-vit-base-patch32
EMBEDDING_DEVICE=cpu

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

LOG_LEVEL=INFO
